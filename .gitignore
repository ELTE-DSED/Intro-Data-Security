# ==========================================================
#  ELTE Introduction to Data Security Practicum
#
#  This repository is two things at once: a Jekyll site and a set of
#  Jupyter lab notebooks. Only those two toolchains are covered here.
# ==========================================================

# ---------- Jekyll (site build output) ----------
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# ---------- Ruby ----------
.bundle/
vendor/
vendor/bundle/

# NOTE: Gemfile.lock is deliberately NOT ignored.
# CI builds and force-publishes the site on every push, so gem versions must
# be reproducible. Without a committed lockfile a new Jekyll release can break
# the deploy without anyone touching the repo.

# ---------- Python / Jupyter (lab notebooks) ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.coverage

# ---------- Virtual environments ----------
.venv/
venv/
env/
.env

# ---------- Editors and OS ----------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~
